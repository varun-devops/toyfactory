{
  "permissions": {
    "allow": [
      "PowerShell(node --version)",
      "PowerShell(npm --version)",
      "PowerShell(Invoke-WebRequest -Uri \"http://localhost:3001\" -UseBasicParsing)",
      "Bash(Get-ChildItem -Path \"d:\\\\websitem\\\\ToyFactory\" -Recurse -Depth 2)",
      "Bash(Select-Object FullName, PSIsContainer)",
      "Bash(Format-Table -AutoSize)",
      "Bash(curl -s http://localhost:3000)",
      "Bash(npx playwright *)",
      "Bash(Remove-Item \"D:\\\\websitem\\\\ToyFactory\\\\*.png\" -Force)",
      "PowerShell(Start-Sleep -Seconds 5; \\(Invoke-WebRequest -Uri \"http://localhost:3099\" -TimeoutSec 10 -UseBasicParsing\\).StatusCode)",
      "PowerShell(Start-Process -FilePath \"npx\" -ArgumentList \"next\",\"dev\",\"--port\",\"3099\" -WorkingDirectory \"d:\\\\websitem\\\\ToyFactory\" -WindowStyle Hidden; Start-Sleep -Seconds 12; try { \\(Invoke-WebRequest -Uri \"http://localhost:3099\" -TimeoutSec 10 -UseBasicParsing\\).StatusCode } catch { \"not ready\" })",
      "PowerShell(Start-Sleep -Seconds 15; try { \\(Invoke-WebRequest -Uri \"http://localhost:3000\" -TimeoutSec 5 -UseBasicParsing\\).StatusCode } catch { \"not ready\" })",
      "PowerShell(cd d:\\\\websitem\\\\ToyFactory; \\(Invoke-WebRequest -Uri \"http://localhost:3000\" -UseBasicParsing -TimeoutSec 5\\).StatusCode)",
      "PowerShell(Start-Process -FilePath \"npx\" -ArgumentList \"next\",\"dev\" -WorkingDirectory \"d:\\\\websitem\\\\ToyFactory\" -WindowStyle Hidden; Start-Sleep -Seconds 18; try { \\(Invoke-WebRequest -Uri \"http://localhost:3000\" -UseBasicParsing -TimeoutSec 8\\).StatusCode } catch { \"still starting\" })",
      "PowerShell(Start-Sleep -Seconds 15; try { \\(Invoke-WebRequest -Uri \"http://localhost:3000\" -UseBasicParsing -TimeoutSec 10\\).StatusCode } catch { $_.Exception.Message })",
      "PowerShell(netstat -ano)"
    ],
    "additionalDirectories": [
      "d:\\websitem\\toyfactory\\src\\lib\\data",
      "d:\\websitem\\toyfactory\\src\\lib",
      "d:\\websitem\\toyfactory\\src\\app",
      "d:\\websitem\\toyfactory\\src\\components",
      "d:\\websitem\\toyfactory"
    ]
  }
}
